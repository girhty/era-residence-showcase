---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Era Residence Luxury Living',
  description = 'Elevated residences in the heart of the city.'
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B121E" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-ink font-sans text-slate-100 antialiased">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink/70 backdrop-blur-xl">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10" aria-label="Primary navigation">
        <a href="/" class="font-display text-xl tracking-wide text-white">ERA<span class="text-brass">.</span></a>
        <div class="hidden items-center gap-8 text-[10px] uppercase tracking-luxury text-slate-300 md:flex">
          <a class="transition hover:text-brass" href="#story">The story</a>
          <a class="transition hover:text-brass" href="#residences">Residences</a>
          <a class="transition hover:text-brass" href="#amenities">Amenities</a>
          <a class="transition hover:text-brass" href="#location">Location</a>
          <a class="border border-brass px-5 py-3 text-brass transition hover:bg-brass hover:text-ink" href="#contact">Arrange a viewing</a>
        </div>
        <button id="menuButton" class="md:hidden" aria-label="Open navigation menu" aria-expanded="false">
          <span class="block h-px w-6 bg-white"></span><span class="mt-2 block h-px w-4 bg-brass"></span>
        </button>
      </nav>
      <div id="mobileMenu" class="hidden border-t border-white/10 bg-charcoal px-6 py-8 md:hidden">
        <div class="flex flex-col gap-6 text-xs uppercase tracking-luxury text-slate-300">
          <a href="#story">The story</a><a href="#residences">Residences</a><a href="#amenities">Amenities</a><a href="#location">Location</a><a href="#contact" class="text-brass">Arrange a viewing</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="border-t border-white/10 bg-charcoal px-6 py-14 lg:px-10">
      <div class="mx-auto flex max-w-7xl flex-col justify-between gap-10 md:flex-row">
        <div><p class="font-display text-3xl">ERA<span class="text-brass">.</span></p><p class="mt-3 max-w-xs text-sm leading-6 text-mist">A new perspective on elevated city living.</p></div>
        <div class="text-sm text-mist"><p class="uppercase tracking-luxury text-brass">Private appointments</p><a class="mt-3 block hover:text-white" href="mailto:hello@eraresidence.example">hello@eraresidence.example</a><a class="mt-1 block hover:text-white" href="tel:+4402010262026">+44 20 1026 2026</a></div>
        <p class="self-end text-xs text-slate-500">© 2026 Era Residence</p>
      </div>
    </footer>
    <script>
      const button = document.querySelector('#menuButton');
      const menu = document.querySelector('#mobileMenu');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>