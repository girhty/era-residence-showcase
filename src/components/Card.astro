---
interface Props {
  title: string;
  text?: string;
  image: string;
  eyebrow?: string;
  class?: string;
}
const { title, text, image, eyebrow, class: className = '' } = Astro.props;
---

<article class={`group relative min-h-[360px] overflow-hidden bg-charcoal ${className}`}>
  <img src={image} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
  <div class="relative flex h-full flex-col justify-end p-6">
    {eyebrow && <p class="mb-2 text-[10px] uppercase tracking-luxury text-brass">{eyebrow}</p>}
    <h3 class="font-display text-2xl text-white">{title}</h3>
    {text && <p class="mt-2 text-sm text-slate-300">{text}</p>}
  </div>
</article>